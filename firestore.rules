rules_version = '2';

// Règles de sécurité StockFlow.
// Ce sont elles qui protègent les données : l'interface ne fait que masquer
// ce qu'un rôle ne peut pas faire. Garder cohérent avec src/lib/roles.ts.
//
// Principe pour le vendeur : toute modification sensible (stock, soldes d'un
// client, totaux du jour) doit citer sa « preuve » — la vente, le mouvement
// de stock ou l'opération du journal — créée DANS LE MÊME BATCH, par lui,
// horodatée par le serveur (cree_le == request.time). Impossible donc de
// modifier un stock ou une dette sans laisser de trace.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions utilitaires ─────────────────────────────────────────────
    function connecte()   { return request.auth != null; }
    function profil()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function actif()      { return connecte()
                                   && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                                   && profil().actif == true; }
    function aRole(roles) { return actif() && profil().role in roles; }
    function gerant()     { return aRole(['gerant']); }
    function seulementChamps(champs) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
    }
    // Horodatage serveur obligatoire sur les « preuves »
    function horodate()   { return request.resource.data.cree_le == request.time; }

    // La vente citée vient d'être créée dans ce batch par l'utilisateur
    function venteDuBatch(id) {
      let v = getAfter(/databases/$(database)/documents/ventes/$(id)).data;
      return v.cree_le == request.time && v.vendeur_uid == request.auth.uid;
    }
    // Le mouvement cité vient d'être créé dans ce batch, pour ce format
    function mouvementDuBatch(id, formatId) {
      let m = getAfter(/databases/$(database)/documents/mouvements_stock/$(id)).data;
      return m.cree_le == request.time && m.utilisateur_uid == request.auth.uid && m.format_id == formatId;
    }
    // La réception citée vient d'être créée dans ce batch par l'utilisateur
    function receptionDuBatch(id) {
      let r = getAfter(/databases/$(database)/documents/receptions/$(id)).data;
      return r.cree_le == request.time && r.utilisateur_uid == request.auth.uid;
    }
    // L'opération citée vient d'être créée dans ce batch, pour ce fournisseur
    function operationFournisseurDuBatch(id, fournisseurId) {
      let o = getAfter(/databases/$(database)/documents/operations_fournisseur/$(id)).data;
      return o.cree_le == request.time && o.utilisateur_uid == request.auth.uid && o.fournisseur_id == fournisseurId;
    }
    // L'opération de journal citée vient d'être créée dans ce batch, pour ce client
    function operationDuBatch(id, clientId) {
      let o = getAfter(/databases/$(database)/documents/operations_client/$(id)).data;
      return o.cree_le == request.time && o.utilisateur_uid == request.auth.uid && o.client_id == clientId;
    }

    // ── Configuration ────────────────────────────────────────────────────
    // proprietaire : créé une seule fois, à la première installation.
    match /config/proprietaire {
      allow get: if true;
      allow create: if connecte()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerant';
      allow update, delete: if false;
    }
    // app : version minimale exigée (force la mise à jour des appareils)
    match /config/app {
      allow read: if connecte();
      allow write: if gerant();
    }

    // ── Utilisateurs ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || gerant());
      // Le gérant crée les comptes ; exception : le tout premier gérant.
      allow create: if gerant()
        || (connecte() && request.auth.uid == uid
            && request.resource.data.role == 'gerant'
            && !exists(/databases/$(database)/documents/config/proprietaire)
            && getAfter(/databases/$(database)/documents/config/proprietaire).data.uid == uid);
      // Personne ne peut changer son propre rôle ; le gérant ne peut pas se désactiver.
      allow update: if gerant()
        && (uid != request.auth.uid
            || (request.resource.data.role == 'gerant' && request.resource.data.actif == true));
      allow delete: if false;
    }

    // ── Catalogue ────────────────────────────────────────────────────────
    match /produits/{id} {
      allow read: if actif();
      allow write: if gerant();
    }
    match /formats/{formatId} {
      allow read: if actif();
      allow create, delete: if gerant();
      allow update: if gerant()
        // Vente : le stock baisse et la vente du batch contient ce format
        || (aRole(['vendeur', 'magasinier'])
            && seulementChamps(['stock', 'derniere_vente'])
            && request.resource.data.stock < resource.data.stock
            && venteDuBatch(request.resource.data.derniere_vente)
            && formatId in getAfter(/databases/$(database)/documents/ventes/$(request.resource.data.derniere_vente)).data.format_ids)
        // Réception fournisseur : le stock monte et la réception du batch contient ce format
        || (aRole(['vendeur', 'magasinier'])
            && seulementChamps(['stock', 'derniere_reception'])
            && request.resource.data.stock > resource.data.stock
            && receptionDuBatch(request.resource.data.derniere_reception)
            && formatId in getAfter(/databases/$(database)/documents/receptions/$(request.resource.data.derniere_reception)).data.format_ids)
        // Réappro ou inventaire : un mouvement de stock du batch l'explique
        || (aRole(['vendeur', 'magasinier'])
            && seulementChamps(['stock', 'dernier_mouvement'])
            && mouvementDuBatch(request.resource.data.dernier_mouvement, formatId));
    }
    match /clients/{clientId} {
      allow read: if aRole(['gerant', 'vendeur']);
      // Le vendeur crée une fiche sans dette (la dette arrive avec la vente, tracée)
      allow create: if gerant()
        || (aRole(['vendeur'])
            && !('solde_argent' in request.resource.data)
            && !('emballages_dus' in request.resource.data)
            && (request.resource.data.est_defaut == 0 || clientId == 'defaut'));
      // Le vendeur ne touche qu'aux soldes, et chaque variation cite son entrée de journal
      allow update: if gerant()
        || (aRole(['vendeur'])
            && seulementChamps(['solde_argent', 'emballages_dus', 'derniere_operation'])
            && operationDuBatch(request.resource.data.derniere_operation, clientId));
      allow delete: if gerant();
    }
    // Journal des comptes clients : on ajoute, on ne modifie ni ne supprime jamais.
    match /operations_client/{id} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow create: if aRole(['gerant', 'vendeur'])
        && request.resource.data.utilisateur_uid == request.auth.uid
        && horodate();
      allow update, delete: if false;
    }
    match /emballages/{id} {
      allow read: if actif();
      allow write: if gerant();
    }
    match /prix_clients/{id} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow write: if gerant();
    }
    // Groupes de prix : grilles partagées par plusieurs clients
    match /groupes_prix/{id} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow write: if gerant();
    }
    match /prix_groupes/{id} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow write: if gerant();
    }

    // ── Ventes ───────────────────────────────────────────────────────────
    match /ventes/{id} {
      allow read: if gerant()
        || (aRole(['vendeur']) && resource.data.vendeur_uid == request.auth.uid);
      allow create: if aRole(['gerant', 'vendeur'])
        && request.resource.data.vendeur_uid == request.auth.uid
        && request.resource.data.statut == 'validée'
        && horodate();
      // Seul le gérant annule une vente (statut uniquement).
      allow update: if gerant() && seulementChamps(['statut', 'date_annulation']);
      allow delete: if false;
    }

    // ── Fournisseurs ─────────────────────────────────────────────────────
    // Le vendeur réceptionne les livraisons ; chaque variation de compte cite son opération.
    match /fournisseurs/{fournisseurId} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow create: if gerant()
        || (aRole(['vendeur'])
            && !('solde_argent' in request.resource.data)
            && !('emballages_dus' in request.resource.data));
      allow update: if gerant()
        || (aRole(['vendeur'])
            && seulementChamps(['solde_argent', 'emballages_dus', 'derniere_operation'])
            && operationFournisseurDuBatch(request.resource.data.derniere_operation, fournisseurId));
      allow delete: if gerant();
    }
    // Bons de réception et journal fournisseur : on ajoute, on ne modifie ni ne supprime jamais.
    match /receptions/{id} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow create: if aRole(['gerant', 'vendeur'])
        && request.resource.data.utilisateur_uid == request.auth.uid
        && horodate();
      allow update, delete: if false;
    }
    match /operations_fournisseur/{id} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow create: if aRole(['gerant', 'vendeur'])
        && request.resource.data.utilisateur_uid == request.auth.uid
        && horodate();
      allow update, delete: if false;
    }
    // Bons de commande : créés « envoyée » ; ne passent « reçue » qu'avec la réception
    // du même batch, chez le même fournisseur. Les quantités commandées ne changent jamais.
    match /commandes_fournisseur/{id} {
      allow read: if aRole(['gerant', 'vendeur']);
      allow create: if aRole(['gerant', 'vendeur'])
        && request.resource.data.utilisateur_uid == request.auth.uid
        && request.resource.data.statut == 'envoyée'
        && request.resource.data.reception_id == null
        && horodate();
      allow update: if aRole(['gerant', 'vendeur'])
        && seulementChamps(['statut', 'reception_id'])
        && resource.data.statut == 'envoyée'
        && request.resource.data.statut == 'reçue'
        && receptionDuBatch(request.resource.data.reception_id)
        && getAfter(/databases/$(database)/documents/receptions/$(request.resource.data.reception_id)).data.fournisseur_id == resource.data.fournisseur_id;
      allow delete: if false;
    }

    // ── Stock ────────────────────────────────────────────────────────────
    match /mouvements_stock/{id} {
      // Le vendeur cumule pour l'instant les tâches de magasinier
      allow read: if aRole(['gerant', 'vendeur', 'magasinier']);
      allow create: if actif() && request.resource.data.utilisateur_uid == request.auth.uid && horodate();
      allow update, delete: if false;
    }

    // ── Statistiques pré-calculées (dashboard) ───────────────────────────
    // Le vendeur ne peut qu'ajouter exactement le montant de la vente du batch.
    match /stats_jour/{jour} {
      allow read: if gerant();
      allow create: if gerant()
        || (aRole(['vendeur'])
            && venteDuBatch(request.resource.data.derniere_vente)
            && request.resource.data.nb_ventes == 1
            && request.resource.data.ca == getAfter(/databases/$(database)/documents/ventes/$(request.resource.data.derniere_vente)).data.total);
      allow update: if gerant()
        || (aRole(['vendeur'])
            && venteDuBatch(request.resource.data.derniere_vente)
            && request.resource.data.nb_ventes == resource.data.get('nb_ventes', 0) + 1
            && request.resource.data.ca == resource.data.get('ca', 0)
                 + getAfter(/databases/$(database)/documents/ventes/$(request.resource.data.derniere_vente)).data.total);
      allow delete: if false;
    }

    // ── Paramètres du commerce ───────────────────────────────────────────
    match /parametres/{id} {
      allow read: if actif();
      allow write: if gerant();
    }
  }
}
