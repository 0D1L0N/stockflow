rules_version = '2';

// Règles de sécurité StockFlow.
// Ce sont elles qui protègent les données : l'interface ne fait que masquer
// ce qu'un rôle ne peut pas faire. Garder cohérent avec src/lib/roles.ts.
//
// Rôles : admin (tout), gerant (ventes, clients, prix, catalogue, stock, fournisseurs),
// magasinier (ventes au prix affiché, stock, réceptions, commandes). Les anciens comptes
// « vendeur » sont des magasiniers. Le propriétaire du dépôt est toujours admin.
//
// Principe pour l'équipe : toute modification sensible (stock, soldes d'un
// client, totaux du jour) doit citer sa « preuve » — la vente, le mouvement
// de stock ou l'opération du journal — créée DANS LE MÊME BATCH, par lui,
// horodatée par le serveur (cree_le == request.time). Impossible donc de
// modifier un stock ou une dette sans laisser de trace.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions utilitaires ─────────────────────────────────────────────
    function connecte()   { return request.auth != null; }
    function profil()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function actif()      { return connecte()
                                   && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                                   && profil().actif == true; }
    // Anciens comptes « vendeur » = magasinier
    function roleActuel() { return profil().role == 'vendeur' ? 'magasinier' : profil().role; }
    function aRole(roles) { return actif() && roleActuel() in roles; }
    function estProprietaire() {
      return exists(/databases/$(database)/documents/config/proprietaire)
        && get(/databases/$(database)/documents/config/proprietaire).data.uid == request.auth.uid;
    }
    // admin : le rôle admin, ou le propriétaire (il ne peut jamais perdre la main sur son dépôt)
    function admin()       { return aRole(['admin']) || (actif() && estProprietaire()); }
    // responsable : admin ou gérant (le propriétaire en fait toujours partie)
    function responsable() { return aRole(['admin', 'gerant']) || (actif() && estProprietaire()); }
    // equipe : tout compte actif qui travaille au dépôt
    function equipe()      { return aRole(['admin', 'gerant', 'magasinier']) || (actif() && estProprietaire()); }
    // La modification touche-t-elle l'un de ces champs ?
    function touche(champs) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(champs);
    }
    function seulementChamps(champs) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
    }
    // Horodatage serveur obligatoire sur les « preuves »
    function horodate()   { return request.resource.data.cree_le == request.time; }

    // La vente citée vient d'être créée dans ce batch par l'utilisateur
    function venteDuBatch(id) {
      let v = getAfter(/databases/$(database)/documents/ventes/$(id)).data;
      return v.cree_le == request.time && v.vendeur_uid == request.auth.uid;
    }
    // Le mouvement cité vient d'être créé dans ce batch, pour ce format
    function mouvementDuBatch(id, formatId) {
      let m = getAfter(/databases/$(database)/documents/mouvements_stock/$(id)).data;
      return m.cree_le == request.time && m.utilisateur_uid == request.auth.uid && m.format_id == formatId;
    }
    // Le mouvement de vides cité vient d'être créé dans ce batch, pour ce type,
    // et le nouveau nombre de vides est exactement l'ancien plus sa variation
    function mouvementVidesDuBatch(id, emballageId) {
      let m = getAfter(/databases/$(database)/documents/mouvements_vides/$(id)).data;
      return m.cree_le == request.time && m.utilisateur_uid == request.auth.uid && m.emballage_id == emballageId
        && request.resource.data.stock_vides == resource.data.get('stock_vides', 0) + m.variation;
    }
    // La réception citée vient d'être créée dans ce batch par l'utilisateur
    function receptionDuBatch(id) {
      let r = getAfter(/databases/$(database)/documents/receptions/$(id)).data;
      return r.cree_le == request.time && r.utilisateur_uid == request.auth.uid;
    }
    // L'opération citée vient d'être créée dans ce batch, pour ce fournisseur
    function operationFournisseurDuBatch(id, fournisseurId) {
      let o = getAfter(/databases/$(database)/documents/operations_fournisseur/$(id)).data;
      return o.cree_le == request.time && o.utilisateur_uid == request.auth.uid && o.fournisseur_id == fournisseurId;
    }
    // L'opération de journal citée vient d'être créée dans ce batch, pour ce client
    function operationDuBatch(id, clientId) {
      let o = getAfter(/databases/$(database)/documents/operations_client/$(id)).data;
      return o.cree_le == request.time && o.utilisateur_uid == request.auth.uid && o.client_id == clientId;
    }

    // ── Configuration ────────────────────────────────────────────────────
    // proprietaire : créé une seule fois, à la première installation.
    match /config/proprietaire {
      allow get: if true;
      allow create: if connecte()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'gerant'];
      allow update, delete: if false;
    }
    // app : version minimale exigée (force la mise à jour des appareils)
    match /config/app {
      allow read: if connecte();
      allow write: if admin();
    }

    // ── Utilisateurs ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || admin());
      // L'admin crée les comptes ; exception : le tout premier compte (le propriétaire).
      allow create: if admin()
        || (connecte() && request.auth.uid == uid
            && request.resource.data.role in ['admin', 'gerant']
            && !exists(/databases/$(database)/documents/config/proprietaire)
            && getAfter(/databases/$(database)/documents/config/proprietaire).data.uid == uid);
      // Un admin ne peut pas se retirer ses droits ni se désactiver ; le propriétaire reste admin et actif.
      allow update: if admin()
        && (uid != request.auth.uid || (request.resource.data.role == 'admin' && request.resource.data.actif == true))
        && (!exists(/databases/$(database)/documents/config/proprietaire)
            || get(/databases/$(database)/documents/config/proprietaire).data.uid != uid
            || (request.resource.data.role == 'admin' && request.resource.data.actif == true));
      allow delete: if false;
    }

    // ── Catalogue ────────────────────────────────────────────────────────
    match /produits/{id} {
      allow read: if actif();
      allow create, update: if responsable();
      allow delete: if admin();
    }
    match /formats/{formatId} {
      allow read: if actif();
      allow create: if responsable();
      allow delete: if admin();
      allow update: if responsable()
        || (equipe() && (
          // Vente : le stock baisse et la vente du batch contient ce format
          (seulementChamps(['stock', 'derniere_vente'])
            && request.resource.data.stock < resource.data.stock
            && venteDuBatch(request.resource.data.derniere_vente)
            && formatId in getAfter(/databases/$(database)/documents/ventes/$(request.resource.data.derniere_vente)).data.format_ids)
          // Réception fournisseur : le stock monte et la réception du batch contient ce format
          || (seulementChamps(['stock', 'derniere_reception'])
            && request.resource.data.stock > resource.data.stock
            && receptionDuBatch(request.resource.data.derniere_reception)
            && formatId in getAfter(/databases/$(database)/documents/receptions/$(request.resource.data.derniere_reception)).data.format_ids)
          // Réappro ou inventaire : un mouvement de stock du batch l'explique
          || (seulementChamps(['stock', 'dernier_mouvement'])
            && mouvementDuBatch(request.resource.data.dernier_mouvement, formatId))));
    }
    match /clients/{clientId} {
      allow read: if equipe();
      // Une fiche se crée sans dette (la dette arrive avec la vente, tracée) ; le magasinier
      // crée seulement la fiche rapide d'un client qui repart avec une dette
      allow create: if admin()
        || (equipe()
            && !('solde_argent' in request.resource.data)
            && !('emballages_dus' in request.resource.data)
            && (request.resource.data.est_defaut == 0 || clientId == 'defaut')
            && (responsable() || !('groupe_prix_id' in request.resource.data)));
      // Le gérant modifie la fiche (nom, téléphone, groupe) mais pas les soldes à la main ;
      // toute variation de solde cite son entrée de journal
      allow update: if admin()
        || (responsable() && !touche(['solde_argent', 'emballages_dus', 'derniere_operation']))
        || (equipe()
            && seulementChamps(['solde_argent', 'emballages_dus', 'derniere_operation'])
            && operationDuBatch(request.resource.data.derniere_operation, clientId));
      allow delete: if admin();
    }
    // Journal des comptes clients : on ajoute, on ne modifie ni ne supprime jamais.
    match /operations_client/{id} {
      allow read: if responsable();
      allow create: if equipe()
        && request.resource.data.utilisateur_uid == request.auth.uid
        && horodate();
      allow update, delete: if false;
    }
    // L'équipe ne touche qu'aux vides au magasin, et chaque variation cite son mouvement
    match /emballages/{id} {
      allow read: if actif();
      allow create, delete: if admin();
      allow update: if admin()
        || (equipe()
            && seulementChamps(['stock_vides', 'dernier_mouvement_vides', 'dernier_comptage'])
            && mouvementVidesDuBatch(request.resource.data.dernier_mouvement_vides, id))
        // Comptage sans écart : seule la date du comptage change
        || (equipe() && seulementChamps(['dernier_comptage']));
    }
    // Journal des casiers vides : on ajoute, on ne modifie ni ne supprime jamais.
    match /mouvements_vides/{id} {
      allow read: if equipe();
      allow create: if equipe()
        && request.resource.data.utilisateur_uid == request.auth.uid
        && horodate();
      allow update, delete: if false;
    }
    // Prix : lus par toute l'équipe (pour vendre), fixés par les responsables
    match /prix_clients/{id} {
      allow read: if equipe();
      allow write: if responsable();
    }
    // Groupes de prix : grilles partagées par plusieurs clients
    match /groupes_prix/{id} {
      allow read: if equipe();
      allow create, update: if responsable();
      allow delete: if admin();
    }
    match /prix_groupes/{id} {
      allow read: if equipe();
      allow write: if responsable();
    }

    // ── Ventes ───────────────────────────────────────────────────────────
    match /ventes/{id} {
      // Les livraisons en cours se lisent par toute l'équipe : n'importe qui note le retour du livreur
      allow read: if responsable()
        || (equipe() && resource.data.vendeur_uid == request.auth.uid)
        || (equipe() && resource.data.livraison.statut == 'en_cours');
      allow create: if equipe()
        && request.resource.data.vendeur_uid == request.auth.uid
        && request.resource.data.statut == 'validée'
        && (!('livraison' in request.resource.data) || request.resource.data.livraison.statut == 'en_cours')
        && horodate();
      // Seul l'admin annule une vente (statut uniquement).
      allow update: if (admin() && seulementChamps(['statut', 'date_annulation']))
        // Règlement après coup (gérant, admin) : seuls les cumuls réglés bougent, ils ne font que monter,
        // et l'entrée du journal client du même batch porte cette vente
        || (responsable()
            && resource.data.statut == 'validée'
            && seulementChamps(['regle_apres', 'rendus_apres', 'dernier_reglement'])
            && request.resource.data.get('regle_apres', 0) >= resource.data.get('regle_apres', 0)
            && operationDuBatch(request.resource.data.dernier_reglement, resource.data.client_id)
            && getAfter(/databases/$(database)/documents/operations_client/$(request.resource.data.dernier_reglement)).data.vente_id == id)
        // Retour du livreur (toute l'équipe) : une seule fois, mêmes livreurs, preuve dans le journal client
        || (equipe()
            && resource.data.statut == 'validée'
            && resource.data.livraison.statut == 'en_cours'
            && request.resource.data.livraison.statut == 'livrée'
            && request.resource.data.livraison.livreurs == resource.data.livraison.livreurs
            && seulementChamps(['regle_apres', 'rendus_apres', 'dernier_reglement', 'livraison'])
            && request.resource.data.get('regle_apres', 0) >= resource.data.get('regle_apres', 0)
            && operationDuBatch(request.resource.data.dernier_reglement, resource.data.client_id)
            && getAfter(/databases/$(database)/documents/operations_client/$(request.resource.data.dernier_reglement)).data.vente_id == id);
      allow delete: if false;
    }

    // ── Fournisseurs ─────────────────────────────────────────────────────
    // Toute l'équipe réceptionne les livraisons ; chaque variation de compte cite son opération.
    match /fournisseurs/{fournisseurId} {
      allow read: if equipe();
      allow create: if admin()
        || (equipe()
            && !('solde_argent' in request.resource.data)
            && !('emballages_dus' in request.resource.data));
      allow update: if admin()
        || (responsable() && !touche(['solde_argent', 'emballages_dus', 'derniere_operation']))
        || (equipe()
            && seulementChamps(['solde_argent', 'emballages_dus', 'derniere_operation'])
            && operationFournisseurDuBatch(request.resource.data.derniere_operation, fournisseurId));
      allow delete: if admin();
    }
    // Bons de réception et journal fournisseur : on ajoute, on ne modifie ni ne supprime jamais.
    match /receptions/{id} {
      allow read: if equipe();
      allow create: if equipe()
        && request.resource.data.utilisateur_uid == request.auth.uid
        && horodate();
      allow update, delete: if false;
    }
    match /operations_fournisseur/{id} {
      allow read: if equipe();
      allow create: if equipe()
        && request.resource.data.utilisateur_uid == request.auth.uid
        && horodate();
      allow update, delete: if false;
    }
    // Bons de commande : créés « envoyée » ; ne passent « reçue » qu'avec la réception
    // du même batch, chez le même fournisseur. Les quantités commandées ne changent jamais.
    match /commandes_fournisseur/{id} {
      allow read: if equipe();
      allow create: if equipe()
        && request.resource.data.utilisateur_uid == request.auth.uid
        && request.resource.data.statut == 'envoyée'
        && request.resource.data.reception_id == null
        && horodate();
      allow update: if equipe()
        && seulementChamps(['statut', 'reception_id'])
        && resource.data.statut == 'envoyée'
        && request.resource.data.statut == 'reçue'
        && receptionDuBatch(request.resource.data.reception_id)
        && getAfter(/databases/$(database)/documents/receptions/$(request.resource.data.reception_id)).data.fournisseur_id == resource.data.fournisseur_id;
      allow delete: if false;
    }

    // ── Stock ────────────────────────────────────────────────────────────
    match /mouvements_stock/{id} {
      allow read: if equipe();
      allow create: if actif() && request.resource.data.utilisateur_uid == request.auth.uid && horodate();
      allow update, delete: if false;
    }

    // ── Statistiques pré-calculées (dashboard) ───────────────────────────
    // Une vente ne peut qu'ajouter exactement son montant ; seul l'admin corrige (annulation).
    match /stats_jour/{jour} {
      allow read: if responsable();
      allow create: if admin()
        || (equipe()
            && venteDuBatch(request.resource.data.derniere_vente)
            && request.resource.data.nb_ventes == 1
            && request.resource.data.ca == getAfter(/databases/$(database)/documents/ventes/$(request.resource.data.derniere_vente)).data.total);
      allow update: if admin()
        || (equipe()
            && venteDuBatch(request.resource.data.derniere_vente)
            && request.resource.data.nb_ventes == resource.data.get('nb_ventes', 0) + 1
            && request.resource.data.ca == resource.data.get('ca', 0)
                 + getAfter(/databases/$(database)/documents/ventes/$(request.resource.data.derniere_vente)).data.total);
      allow delete: if false;
    }

    // ── Journal des actions ──────────────────────────────────────────────
    // Chacun note ses propres actions (horodatées par le serveur) ; seuls les responsables le lisent
    // et seul l'admin marque une action comme restaurée. Rien ne s'efface ni ne se réécrit.
    match /journal/{id} {
      allow read: if responsable();
      allow create: if equipe()
        && request.resource.data.utilisateur_uid == request.auth.uid
        && request.resource.data.restaure_le == null
        && horodate();
      allow update: if admin()
        && resource.data.restaure_le == null
        && seulementChamps(['restaure_le', 'restaure_par']);
      allow delete: if false;
    }

    // ── Paramètres du commerce ───────────────────────────────────────────
    match /parametres/{id} {
      allow read: if actif();
      allow write: if admin();
    }
  }
}
